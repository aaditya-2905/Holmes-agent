# Copy to .env and fill in. .env is gitignored.

# LLM provider key and model (LiteLLM model id).
# OPENROUTER_API_KEY=
MODEL=gemini/gemini-3.5-flash
# How hard the model "thinks" per step (low|medium|high). Lower = faster; low is plenty for most checks.
REASONING_EFFORT=low
# Other providers work too - set the matching key and a MODEL like
# anthropic/claude-sonnet-4-5-20250929 or gpt-4.1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
GEMINI_API_KEY=

# Ports on 127.0.0.1
UI_PORT=8088
HOLMES_PORT=5050

# Host group IDs granted to the agent container:
#   getent group docker | cut -d: -f3
#   getent group systemd-journal | cut -d: -f3
DOCKER_GID=984
JOURNAL_GID=999
